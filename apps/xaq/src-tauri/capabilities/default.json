{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Minimal rights for the viewer window: events, window theme, writing text to the clipboard.",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:event:default",
    "core:webview:default",
    "core:window:allow-set-theme",
    "clipboard-manager:allow-write-text"
  ]
}
