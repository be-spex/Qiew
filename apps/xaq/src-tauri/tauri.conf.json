{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Xaq",
  "mainBinaryName": "xaq",
  "version": "0.3.2",
  "identifier": "net.spex.xaq",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Xaq",
        "width": 920,
        "height": 1000,
        "minWidth": 360,
        "minHeight": 240,
        "decorations": true,
        "transparent": false,
        "resizable": true,
        "dragDropEnabled": true,
        "visible": false
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data:",
        "font-src": "'self' data:",
        "connect-src": "ipc: http://ipc.localhost",
        "object-src": "'none'",
        "frame-src": "'none'"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "deb",
      "appimage"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": [
          "xml",
          "wsdl",
          "xsd",
          "xsl",
          "xslt"
        ],
        "name": "XML",
        "description": "XML document",
        "role": "Viewer",
        "mimeType": "application/xml"
      },
      {
        "ext": [
          "xhtml",
          "html",
          "htm"
        ],
        "name": "HTML",
        "description": "HTML document",
        "role": "Viewer",
        "mimeType": "text/html"
      }
    ],
    "linux": {
      "deb": {
        "desktopTemplate": "xaq.desktop"
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEI5N0MxRTlFMjlGN0FCNkQKUldSdHEvY3BuaDU4dVJ4WVlqTll2b25sMmdhUlVjNXJhZDFZMEZNU3RxeVlqdXRZWlJyeGdsbUoK",
      "endpoints": [
        "https://github.com/be-spex/Qiew/releases/download/updater/xaq.json"
      ]
    }
  }
}
