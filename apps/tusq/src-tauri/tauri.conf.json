{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Tusq",
  "mainBinaryName": "tusq",
  "version": "0.2.0",
  "identifier": "net.spex.tusq",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Tusq",
        "width": 1280,
        "height": 900,
        "minWidth": 360,
        "minHeight": 240,
        "decorations": true,
        "transparent": false,
        "resizable": true,
        "dragDropEnabled": true,
        "visible": false
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data:",
        "font-src": "'self' data:",
        "connect-src": "ipc: http://ipc.localhost",
        "object-src": "'none'",
        "frame-src": "tusq:"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "deb",
      "appimage"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": [
          "tsx"
        ],
        "name": "TSX",
        "description": "TSX component",
        "role": "Viewer",
        "mimeType": "text/tsx"
      },
      {
        "ext": [
          "jsx"
        ],
        "name": "JSX",
        "description": "JSX component",
        "role": "Viewer",
        "mimeType": "text/jsx"
      }
    ],
    "linux": {
      "deb": {
        "desktopTemplate": "tusq.desktop",
        "files": {
          "/usr/share/mime/packages/tusq.xml": "tusq.xml"
        }
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEI5N0MxRTlFMjlGN0FCNkQKUldSdHEvY3BuaDU4dVJ4WVlqTll2b25sMmdhUlVjNXJhZDFZMEZNU3RxeVlqdXRZWlJyeGdsbUoK",
      "endpoints": [
        "https://github.com/be-spex/Qiew/releases/download/updater/tusq.json"
      ]
    }
  }
}
