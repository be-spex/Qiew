# Maintainer: Bert Speckels <skrrytch at speckels dot net>
pkgname=marq-bin
pkgver=0.1.1
pkgrel=1
pkgdesc="Lightweight read-only Markdown viewer"
arch=('x86_64')
url="https://github.com/Skrrytch/Marq"
license=('MIT')
depends=('webkit2gtk-4.1' 'gtk3' 'hicolor-icon-theme')
optdepends=('xdg-utils: register Marq as the default Markdown viewer')
provides=('marq')
conflicts=('marq')
source=("Marq_${pkgver}_amd64.deb::${url}/releases/download/v${pkgver}/Marq_${pkgver}_amd64.deb"
        "LICENSE-${pkgver}::https://raw.githubusercontent.com/Skrrytch/Marq/v${pkgver}/LICENSE")
sha256sums=('818f4d9a5602f18f1b2053a22b3b4aa32dd3575a17ac9fdcc5630d2ce46cf163'
            'eb623b9a1690b7c81266504114a64a877a5e670eef6cf187bd735d0a397addcb')

package() {
  # makepkg has already unpacked the .deb (an ar archive) into $srcdir.
  bsdtar -xf data.tar.gz -C "$pkgdir"
  install -Dm644 "LICENSE-${pkgver}" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
