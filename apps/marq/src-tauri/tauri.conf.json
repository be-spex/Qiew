{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Marq",
  "mainBinaryName": "marq",
  "version": "0.1.0",
  "identifier": "de.lab.marq",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Marq",
        "width": 920,
        "height": 1000,
        "minWidth": 360,
        "minHeight": 240,
        "decorations": true,
        "transparent": false,
        "resizable": true,
        "dragDropEnabled": true,
        "visible": false
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' asset: http://asset.localhost https: data:",
        "font-src": "'self' data:",
        "connect-src": "ipc: http://ipc.localhost",
        "object-src": "'none'",
        "frame-src": "'none'"
      },
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": [
          "md",
          "markdown"
        ],
        "name": "Markdown",
        "description": "Markdown document",
        "role": "Viewer",
        "mimeType": "text/markdown"
      }
    ],
    "linux": {
      "deb": {
        "desktopTemplate": "marq.desktop"
      },
      "rpm": {
        "desktopTemplate": "marq.desktop"
      }
    }
  }
}
