@@ -7,34 +7,29 @@ export interface Order {
 }
 
 const TAX_RATE = 0.19;
+const DEFAULT_CURRENCY = "EUR";
 
 export function priceWithTax(net: number): number {
   return net * (1 + TAX_RATE);
 }
 
 export function describe(order: Order): string {
-  return legacyFormat(order.customer) + " ordered for " + order.total + " EUR";
+  return `${order.customer} ordered for ${formatMoney(order.total, DEFAULT_CURRENCY)}`;
