@@ -0,0 +1,6 @@
+/**
+ * Formats an amount of money for display, e.g. "1.234,50 €".
+ */
+export function formatMoney(amount: number, currency: string): string {
+  return new Intl.NumberFormat("de-DE", { style: "currency", currency }).format(amount);
+}
